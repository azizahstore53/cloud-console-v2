# --- Database ---
# Local dev:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloud_console?schema=public"

# IDCloudHost Managed Database (PostgreSQL) — get host/port/user/password/db
# name from console.idcloudhost.com after provisioning. Managed instances
# typically require SSL — confirm with the credentials panel and adjust
# sslmode if the connection is rejected.
# DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?schema=public&sslmode=require"

# --- Auth.js (NextAuth) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Cloud Provider Adapter ---
# "mock" works out of the box with no credentials. Switch to a real adapter later.
CLOUD_PROVIDER="mock"

# IDCloudHost Cloud VPS (set CLOUD_PROVIDER=idcloudhost to use)
# Get an API token from https://app.idcloudhost.com/
# IDCLOUDHOST_API_KEY=
# Location slug, e.g. "jkt01" / "jkt02" / "jkt03" / "sgp01". Omit for account default.
# IDCLOUDHOST_LOCATION=
# Only needed if your API token isn't already restricted to one billing account.
# IDCLOUDHOST_BILLING_ACCOUNT_ID=
# Optional — omit to auto-detect the account's default resource pool.
# IDCLOUDHOST_DESIGNATED_POOL_UUID=
# Optional — omit to use the default private network.
# IDCLOUDHOST_NETWORK_UUID=

# OPENSTACK_AUTH_URL=
# OPENSTACK_USERNAME=
# OPENSTACK_PASSWORD=
# OPENSTACK_PROJECT_ID=
# PROXMOX_API_URL=https://pve.example.com:8006
# PROXMOX_API_TOKEN=user@pam!tokenid=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PROXMOX_TARGET_NODE=pve-01
# PROXMOX_DEFAULT_STORAGE=local-lvm
# PROXMOX_ALLOW_INSECURE_TLS=true
# PROXMOX_TEMPLATES={"ubuntu-22-04":{"node":"pve-01","vmid":9000},"debian-12":{"node":"pve-01","vmid":9001}}
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# --- Payment Gateway (mock structure, matches Xendit-style payloads) ---
PAYMENT_GATEWAY="mock"

# doit.id (set PAYMENT_GATEWAY=doit to use) — see
# src/lib/payment/providers/DoitPaymentGateway.ts for important caveats:
# this adapter was built without access to doit.id's full API docs, so
# request/response field names and the webhook signature scheme are
# best-effort placeholders that need verification against your account's
# own docs before going live.
# DOIT_API_KEY=              # pb_test_xxx / pb_live_xxx from the doit.id dashboard
# DOIT_WEBHOOK_SECRET=       # whs_xxx — never commit the real value; keep it only in your local .env
# Header name your doit.id account actually sends the webhook signature in
# — unconfirmed, adjust once you've checked a real webhook delivery.
# PAYMENT_WEBHOOK_SIGNATURE_HEADER="x-callback-token"

# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=

# --- App ---
NEXT_PUBLIC_APP_NAME="CloudConsole"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Hourly Usage Billing ---
# Required to call POST/GET /api/cron/billing (see README "Hourly Usage
# Billing"). Not needed if you only run `npm run billing:run` via system
# crontab, since that talks to the database directly.
CRON_SECRET="generate-with-openssl-rand-base64-32"
# Wallet balance (IDR) below which a one-time low-balance warning activity
# log entry is created for the user.
LOW_BALANCE_WARNING_THRESHOLD="50000"

# --- News / Berita (Telegram bot + Groq AI) ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...          # from @BotFather
# TELEGRAM_WEBHOOK_SECRET=                       # generate: openssl rand -hex 32
# TELEGRAM_ADMIN_CHAT_ID=                        # your personal Telegram chat_id — only this id can trigger the bot
# TELEGRAM_SUPPORT_CHAT_ID=                      # optional: separate chat/group for ticket alerts (falls back to TELEGRAM_ADMIN_CHAT_ID above)
# GROQ_API_KEY=                                  # console.groq.com
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Email (SMTP) — password reset links, etc. ---
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587                # 587 = STARTTLS (most common), 465 = implicit TLS
# SMTP_SECURE=false            # set "true" only if using port 465
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=
# SMTP_FROM="CloudConsole <noreply@yourdomain.com>"
# SMTP_TLS_SERVERNAME=        # only if SMTP_HOST doesn't match the cert's name, e.g. host is "mail.example.com" but the cert covers "example.com" — set this to "example.com"

# --- Support ticket attachments ---
# TICKET_UPLOADS_DIR=./uploads/tickets   # optional override; defaults to ./uploads/tickets (outside public/, never web-accessible directly)
