// ============================================================================
// Cloud Console Platform — Prisma Schema
// PostgreSQL + Prisma ORM
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  BILLING
  SUPPORT
  DEVELOPER
  CUSTOMER
}

enum FirewallProtocol {
  TCP
  UDP
  ICMP
}

enum FirewallAction {
  ALLOW
  DENY
}

enum InstanceStatus {
  PROVISIONING
  RUNNING
  STOPPED
  REBOOTING
  TERMINATING
  TERMINATED
  ERROR
}

enum InstanceAction {
  START
  STOP
  REBOOT
  TERMINATE
}

enum DeploymentStatus {
  PENDING
  DEPLOYING
  RUNNING
  FAILED
  STOPPED
  REMOVED
}

enum BlueprintType {
  WORDPRESS
  NODEJS
  DOCKER
  POSTGRESQL
  MYSQL
  REDIS
  STATIC_SITE
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum TransactionType {
  TOPUP
  USAGE_CHARGE
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum PaymentGateway {
  XENDIT
  MIDTRANS
  DOIT
  MANUAL_TRANSFER
  BALANCE
}

enum BillingCycle {
  HOURLY
  MONTHLY
}

enum ActivityCategory {
  AUTH
  INSTANCE
  BILLING
  DEPLOYMENT
  SSH_KEY
  ACCOUNT
  SYSTEM
}

enum VpnStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
}

// ----------------------------------------------------------------------------
// USER & AUTH
// ----------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  passwordHash    String?
  image           String?
  role            Role      @default(CUSTOMER)
  companyName     String?
  phoneNumber     String?

  balance         Int       @default(0)
  currency        String    @default("IDR")
  isActive        Boolean   @default(true)

  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorRecoveryCodes String? @db.Text
  lastTwoFactorVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  instances       Instance[]
  deployments     Deployment[]
  sshKeys         SshKey[]
  invoices        Invoice[]
  transactions    Transaction[]
  activityLogs    ActivityLog[]
  passwordResets  PasswordResetToken[]
  notifications   Notification[]
  ticketsOpened   SupportTicket[]  @relation("TicketCustomer")
  ticketsAssigned SupportTicket[]  @relation("TicketAssignee")
  ticketMessages  TicketMessage[]  @relation("TicketMessageSender")
  vpnClients      VpnClient[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model SshKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  publicKey   String   @db.Text
  fingerprint String
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances Instance[]

  @@unique([userId, name])
  @@map("ssh_keys")
}

// ----------------------------------------------------------------------------
// COMPUTE — VIRTUAL MACHINES / INSTANCES
// ----------------------------------------------------------------------------

model Region {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  country   String
  isActive  Boolean  @default(true)

  instances Instance[]

  @@map("regions")
}

model InstancePlan {
  id            String   @id @default(cuid())
  name          String
  vcpu          Int
  ramMb         Int
  storageGb     Int
  pricePerHour  Int
  pricePerMonth Int
  isActive      Boolean  @default(true)

  instances Instance[]

  @@map("instance_plans")
}

model Instance {
  id             String          @id @default(cuid())
  userId         String
  name           String
  hostname       String?
  status         InstanceStatus  @default(PROVISIONING)
  provider       String          @default("mock")
  externalId     String?
  imageSlug      String
  imageLabel     String
  regionId       String
  planId         String
  sshKeyId       String?
  ipv4Address    String?
  ipv6Address    String?
  billingCycle   BillingCycle    @default(HOURLY)
  provisionedAt  DateTime?
  terminatedAt   DateTime?
  lastBilledAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  region         Region          @relation(fields: [regionId], references: [id])
  plan           InstancePlan    @relation(fields: [planId], references: [id])
  sshKey         SshKey?         @relation(fields: [sshKeyId], references: [id])

  deployments    Deployment[]
  usageRecords   UsageRecord[]
  firewallRules   FirewallRule[]
  snapshots      InstanceSnapshot[]
  activityLogs   ActivityLog[]
  supportTickets SupportTicket[]

  @@index([userId])
  @@map("instances")
}

model UsageRecord {
  id          String   @id @default(cuid())
  instanceId  String
  periodStart DateTime
  periodEnd   DateTime
  amount      Int
  billed      Boolean  @default(false)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("usage_records")
}

model InstanceSnapshot {
  id          String   @id @default(cuid())
  instanceId  String
  name        String
  externalId  String
  sizeGb      Float?
  createdAt   DateTime @default(now())

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("instance_snapshots")
}

model FirewallRule {
  id          String           @id @default(cuid())
  instanceId  String
  protocol    FirewallProtocol @default(TCP)
  portStart   Int
  portEnd     Int
  source      String           @default("0.0.0.0/0")
  action      FirewallAction   @default(ALLOW)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("firewall_rules")
}

// ----------------------------------------------------------------------------
// APP DEPLOYER (PaaS)
// ----------------------------------------------------------------------------

model Blueprint {
  id          String        @id @default(cuid())
  type        BlueprintType
  name        String
  description String
  iconSlug    String
  isActive    Boolean       @default(true)

  deployments Deployment[]

  @@map("blueprints")
}

model Deployment {
  id           String           @id @default(cuid())
  userId       String
  instanceId   String?
  blueprintId  String
  name         String
  status       DeploymentStatus @default(PENDING)
  config       Json?
  domain       String?
  logsUrl      String?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deployedAt   DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance  Instance?  @relation(fields: [instanceId], references: [id])
  blueprint Blueprint  @relation(fields: [blueprintId], references: [id])

  @@index([userId])
  @@map("deployments")
}

// ----------------------------------------------------------------------------
// BILLING — WALLET, INVOICES, TRANSACTIONS
// ----------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(cuid())
  userId        String
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  subtotal      Int
  tax           Int           @default(0)
  total         Int
  currency      String        @default("IDR")
  dueDate       DateTime
  paidAt        DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items InvoiceItem[]
  transactions Transaction[]

  @@index([userId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  amount      Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Transaction {
  id          String             @id @default(cuid())
  userId      String
  invoiceId   String?
  type        TransactionType
  status      TransactionStatus  @default(PENDING)
  amount      Int
  balanceBefore Int              @default(0)
  balanceAfter Int
  gateway     PaymentGateway?
  gatewayRef  String?
  paymentUrl  String?           @db.Text
  description String?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([gatewayRef])
  @@index([userId])
  @@map("transactions")
}

model ActivityLog {
  id          String           @id @default(cuid())
  userId      String
  instanceId  String?
  category    ActivityCategory
  action      String
  message     String
  createdAt   DateTime         @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance Instance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instanceId])
  @@map("activity_logs")
}

// ----------------------------------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// NEWS / BLOG
// ----------------------------------------------------------------------------

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum NewsSource {
  MANUAL
  AI_TELEGRAM
}

model News {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String
  content        String     @db.Text
  coverImageUrl  String?
  status         NewsStatus @default(DRAFT)
  source         NewsSource @default(MANUAL)
  aiPrompt       String?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("news")
}

// ----------------------------------------------------------------------------
// SUPPORT TICKETS (customer <-> support chat)
// ----------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum TicketMessageSender {
  CUSTOMER
  STAFF
  SYSTEM
}

model SupportTicket {
  id                String       @id @default(cuid())
  subject           String
  status            TicketStatus @default(OPEN)
  customerId        String
  assignedToId      String?
  relatedInstanceId String?
  customerUnread    Boolean      @default(false)
  lastMessageAt     DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  customer          User         @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo        User?        @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  relatedInstance   Instance?    @relation(fields: [relatedInstanceId], references: [id], onDelete: SetNull)
  messages          TicketMessage[]

  @@index([customerId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@map("support_tickets")
}

model TicketMessage {
  id         String              @id @default(cuid())
  ticketId   String
  senderId   String?
  senderType TicketMessageSender
  body       String              @db.Text
  imageUrl   String?
  imageName  String?
  createdAt   DateTime            @default(now())

  ticket     SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     User?               @relation("TicketMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ----------------------------------------------------------------------------
// VPN & TUNNELING (WireGuard)
// ----------------------------------------------------------------------------

model VpnIpPool {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vpn_ip_pool")
}

model VpnPublicIpPool {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vpn_public_ip_pool")
}

model VpnServer {
  id            String   @id @default(cuid())
  name          String
  publicIp      String   @unique
  wireguardPort Int      @default(51820)
  privateKey    String   @db.Text
  publicKey     String   @unique
  sshPrivateKey String?  @db.Text
  sshPassword   String?  @db.Text
  sshUser       String   @default("root")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime  @updatedAt

  clients       VpnClient[]

  @@map("vpn_servers")
}

model VpnClient {
  id              String    @id @default(cuid())
  userId          String
  vpnServerId     String
  publicKey       String    @unique
  privateKey      String    @db.Text
  internalIp      String    @unique
  allocatedPublicIp String?  @unique
  vpnInstallToken String?   @unique
  status          VpnStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vpnServer       VpnServer @relation(fields: [vpnServerId], references: [id])
  portMappings    VpnPortMapping[]

  @@index([userId])
  @@index([vpnServerId])
  @@map("vpn_clients")
}

model VpnPortMapping {
  id           String    @id @default(cuid())
  vpnClientId  String
  publicPort   Int
  localPort    Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client       VpnClient @relation(fields: [vpnClientId], references: [id], onDelete: Cascade)

  @@unique([vpnClientId, publicPort])
  @@map("vpn_port_mappings")
}
